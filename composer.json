{
    "name": "session-planner-for-wordcamps/session-planner-for-wordcamps",
    "description": "Session Planner for WordCamps - A WordPress app powered by WpApp",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "akirk/wp-app": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "SessionPlannerForWordCamps\\": "src/"
        }
    },
    "version": "1.0.0",
    "authors": [
        {
            "name": "Alex Kirk"
        }
    ],
    "config": {
        "autoloader-suffix": "sessionplannerforwordcamps"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "^7.1",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "scripts": {
        "test": "phpunit"
    }
}
